    {
      "id": "post-seed-1",
      "title": "Saturday social rides need clearer regroup points",
      "createdBy": "Amina Yusuf",
      "createdById": "member-seed-3",
      "body": "The route worked, but new riders had trouble knowing where the first full regroup would happen. Next time we should note two obvious landmarks in the route post so nobody has to guess whether they should keep pushing or soft pedal.",
      "createdAt": "2026-05-13T14:05:00.000Z"
    },
    {
      "id": "post-seed-2",
      "title": "Rain route fallback for weekday spins",
      "createdBy": "Theo Johnson",
      "createdById": "member-seed-2",
      "body": "When the streets are slick, the lower-traffic river option is still good, but the club should pin one short fallback loop for commuters who want a predictable thirty to forty minutes without debating conditions in the group chat.",
      "createdAt": "2026-05-12T20:50:00.000Z"
    },
    {
      "id": "post-seed-3",
      "title": "Volunteer ride for trail cleanup",
      "createdBy": "Marisol Vega",
      "createdById": "member-seed-1",
      "body": "A ride-to-cleanup format would fit this group well: meet at the bridge, spin to the work site, spend an hour helping out, then head to coffee after. This space can double as the planning board for those kinds of club days.",
      "createdAt": "2026-05-11T15:15:00.000Z"
    }
